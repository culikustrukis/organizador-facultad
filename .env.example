# Copiá este archivo a .env y completá los valores en tu entorno de despliegue.
# NUNCA subas el .env real a Git.

# Clave secreta para firmar las sesiones. Generá una nueva con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Si no se define, se usa una clave fija SOLO apta para desarrollo local.
SECRET_KEY=

# Activar modo debug (1) SOLO en desarrollo local. En producción dejar vacío o 0.
FLASK_DEBUG=0

# Activar cookies de sesión solo por HTTPS (1) cuando el sitio use SSL.
SESSION_COOKIE_SECURE=1

# Ruta del archivo SQLite. En desarrollo vacío = database.db junto al código.
# En producción apuntar a un volumen/almacenamiento persistente, p. ej.:
# DATABASE_PATH=/var/data/database.db
DATABASE_PATH=