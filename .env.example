# Copiá este archivo a .env y completá los valores en tu entorno de despliegue.
# NUNCA subas el .env real a Git.

# Cadena de conexión a PostgreSQL (Supabase). Copiala desde:
#   Supabase > Project Settings > Database > Connection string (ORMs / libpq).
# Ejemplo:
#   DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Clave secreta para firmar las sesiones. Generá una nueva con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Activar modo debug (1) SOLO en desarrollo local. En producción dejar vacío o 0.
FLASK_DEBUG=0

# Activar cookies de sesión solo por HTTPS (1) cuando el sitio use SSL.
SESSION_COOKIE_SECURE=1